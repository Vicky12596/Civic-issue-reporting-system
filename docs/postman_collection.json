{
  "info": {
    "name": "CivicConnect API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Jane Citizen\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"phone\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"jane@example.com\",\n  \"password\": \"Passw0rd!\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/forgot-password?email=jane@example.com" }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/issues",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Pothole on Main St\",\n  \"description\": \"Large pothole causing traffic issues\",\n  \"categoryId\": 1,\n  \"latitude\": 11.0168,\n  \"longitude\": 76.9558,\n  \"address\": \"Main St\",\n  \"city\": \"Coimbatore\",\n  \"priority\": \"HIGH\",\n  \"isAnonymous\": false\n}" }
          }
        },
        { "name": "Get All Issues", "request": { "method": "GET", "url": "{{baseUrl}}/issues" } },
        { "name": "Get Issue By Id", "request": { "method": "GET", "url": "{{baseUrl}}/issues/1" } },
        { "name": "My Reports", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/issues/my-reports" } },
        { "name": "Trending Issues", "request": { "method": "GET", "url": "{{baseUrl}}/issues/trending" } },
        { "name": "Vote", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/issues/1/vote" } },
        {
          "name": "Update Status (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/issues/1/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"VERIFIED\",\n  \"remarks\": \"Confirmed by field inspector\"\n}" }
          }
        },
        { "name": "Delete Issue (Admin)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/issues/1" } }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/issues/1/comments",
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"This has been an issue for weeks!\"\n}" }
          }
        },
        { "name": "List Comments", "request": { "method": "GET", "url": "{{baseUrl}}/issues/1/comments" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Dashboard Stats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/dashboard-stats" } },
        { "name": "List Users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/admin/users" } }
      ]
    },
    {
      "name": "Files",
      "item": [
        { "name": "Upload File", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/files/upload" } }
      ]
    }
  ]
}
